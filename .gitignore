# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# A shipped build copies them in instead.
#
# THIS LIST IS ALSO THE DEPENDENCY MANIFEST. gs-bootstrap derives what to link from
# these lines rather than keeping a second copy, because the repository that gains a
# dependency is the repository that has to ignore its link.
/addons/gs_core
/addons/gs_input
/addons/gs_profile
/addons/gs_profiler
/addons/gs_lighting
/addons/gs_entity
/addons/gs_physics
/addons/gs_player
/addons/gs_player_char
/addons/gs_animation
/addons/gs_save
/addons/gs_camera
/addons/gs_player_controller
/addons/gs_props
/addons/gs_combat
/addons/gs_match
/addons/gs_vehicle
/addons/gs_weapon
/addons/gs_ui
/addons/gs_settings
/addons/gs_menu
/addons/gs_mobile
/addons/gs_console
/addons/gs_fx
/addons/gs_net
/addons/gs_server
/addons/gs_game
# gs-sim: optional native library (snapshot codec); without its built library the GDScript twins run.
# bootstrap fetches this release's library for the machine (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-sim v0.2.10
/addons/gs_sim
/addons/gs_workbench
/addons/gs_chat
/addons/gs_voice
/addons/gs_moderation
/addons/gs_spectate
/addons/gs_audio
/addons/gs_stats
/addons/gs_achievements
/addons/gs_cloud
/addons/gs_auth
/addons/gs_user
/addons/gs_user_avatar
/addons/gs_platform
/addons/gs_map
/addons/gs_vote
/addons/gs_replay
/addons/gs_bot
/addons/gs_spawn
/addons/gs_team
/addons/zee_weapons

# The courses and arenas: the mg-wipeout-maps repository, linked here by gs-bootstrap off
# the comment line below (copied, on Windows). A checkout without it plays the one practice
# course built into game/wo_catalogue.gd, which is a supported state, not a broken one.
# bootstrap-link: mg-wipeout-maps/courses ci
/courses
# The courses' own cvar files (cfg/<course id>.cfg), the same repository.
# bootstrap-link: mg-wipeout-maps/cfg ci
/cfg
# Imported course geometry (gs-bsp-mesh files), the same repository.
# bootstrap-link: mg-wipeout-maps/worlds ci
/worlds

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/

# Editors
.vscode/
# art stores the worlds name (licence.pbr_store ../pbr-library): symlinks to mg-wipeout-maps, see its CLAUDE.md
/pbr-library
/model-library
/addons/gs_weather
/addons/gs_flashlight
